{
  "name": "@measurement-portal/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json && cp -R src/db/migrations dist/db/",
    "start": "node dist/server.js",
    "start:migrate": "npm run db:migrate:prod && npm start",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run src",
    "test:integration": "RUN_DB_TESTS=true vitest run src/integration",
    "test:integration:storage": "RUN_DB_TESTS=true RUN_STORAGE_TESTS=true vitest run src/integration",
    "db:migrate": "node --import tsx src/db/migrate.ts",
    "db:migrate:prod": "node dist/db/migrate.js",
    "admin:create": "node --import tsx src/scripts/create-admin.ts",
    "admin:create:prod": "node dist/scripts/create-admin.js",
    "storage:check": "node --import tsx src/scripts/check-storage.ts",
    "storage:smoke": "node --import tsx src/scripts/smoke-storage.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1136.0",
    "bcryptjs": "^3.0.3",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.1.0",
    "multer": "^2.4.0",
    "pg": "^8.16.3",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/express": "^5.0.3",
    "@types/multer": "^2.2.0",
    "@types/node": "^22.18.1",
    "@types/pg": "^8.15.5",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "supertest": "^7.2.2",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^5.0.1"
  }
}
