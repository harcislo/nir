# Public hostname without protocol, for example lablog.example.ru
DOMAIN=

# Use a long URL-safe password containing letters and numbers.
POSTGRES_DB=measurement_portal
POSTGRES_USER=measurement
POSTGRES_PASSWORD=

NODE_ENV=production
PORT=4000
TRUST_PROXY=true

SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=measurement_session
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10

YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_REGION=ru-central1
YANDEX_STORAGE_BUCKET=
YANDEX_STORAGE_ACCESS_KEY_ID=
YANDEX_STORAGE_SECRET_ACCESS_KEY=
