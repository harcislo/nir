NODE_ENV=development
PORT=4000
DATABASE_URL=postgres://measurement:measurement@localhost:5432/measurement_portal

# Yandex Object Storage (S3-compatible API)
YANDEX_STORAGE_ENDPOINT=https://storage.yandexcloud.net
YANDEX_STORAGE_REGION=ru-central1
YANDEX_STORAGE_BUCKET=
YANDEX_STORAGE_ACCESS_KEY_ID=
YANDEX_STORAGE_SECRET_ACCESS_KEY=

# Server session lifetime
SESSION_TTL_HOURS=168
SESSION_COOKIE_NAME=measurement_session
LOGIN_RATE_LIMIT_WINDOW_MINUTES=15
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=10
TRUST_PROXY=false
