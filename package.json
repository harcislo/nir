{
  "name": "measurement-portal",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -n API,WEB -c blue,green \"npm run dev --workspace @measurement-portal/api\" \"npm run dev --workspace @measurement-portal/web\"",
    "dev:api": "npm run dev --workspace @measurement-portal/api",
    "dev:web": "npm run dev --workspace @measurement-portal/web",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:integration": "npm run test:integration --workspace @measurement-portal/api",
    "test:integration:storage": "npm run test:integration:storage --workspace @measurement-portal/api",
    "db:migrate": "npm run db:migrate --workspace @measurement-portal/api",
    "admin:create": "npm run admin:create --workspace @measurement-portal/api",
    "storage:check": "npm run storage:check --workspace @measurement-portal/api",
    "storage:smoke": "npm run storage:smoke --workspace @measurement-portal/api",
    "db:backup": "bash scripts/backup-db.sh"
  },
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "concurrently": "^10.0.5"
  }
}
